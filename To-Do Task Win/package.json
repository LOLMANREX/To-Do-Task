{
  "name": "to-do-win",
  "version": "1.0.13",
  "description": "Application de gestion de tâches et productivité To-Do Task Win",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "build:frontend": "cd frontend && npm run build",
    "pack": "npm run build:frontend && electron-builder --dir",
    "dist": "npm run build:frontend && electron-builder",
    "setup": "npm run dist"
  },
  "keywords": [
    "todo",
    "productivity",
    "electron",
    "pwa",
    "windows"
  ],
  "author": "To-Do Task",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-is-dev": "^3.0.1",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "sql.js": "^1.14.2"
  },
  "build": {
    "npmRebuild": false,
    "compression": "maximum",
    "appId": "com.todotask.win",
    "productName": "To-Do Task Win",
    "copyright": "Copyright © 2026 To-Do Task",
    "icon": "build/icon.ico",
    "artifactName": "Installation.${ext}",
    "afterPack": "build/afterPack.js",
    "electronLanguages": [
      "fr",
      "en-US"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "To-Do Task Win",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "runAfterFinish": true,
      "differentialPackage": false
    },
    "asar": true,
    "files": [
      "index.js",
      "error.html",
      "backend/src/**/*",
      "frontend/dist/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,test,tests,example,examples,docs,.github}",
      "!**/node_modules/sql.js/dist/sql-asm*",
      "!**/node_modules/sql.js/dist/worker*",
      "!**/node_modules/sql.js/dist/*.zip",
      "!**/node_modules/sql.js/dist/*debug*",
      "!**/node_modules/sql.js/dist/sql-wasm-browser*"
    ]
  }
}
